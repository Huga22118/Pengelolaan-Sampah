generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum untuk role user
enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  nama      String
  nik       String   @unique
  email     String   @unique
  noHp      String   @unique
  password  String                        // Untuk login
  role      Role     @default(USER)       // Default role adalah USER
  
  laporan   LaporanSampah[]
}

model JenisSampah {
  id        String           @id @default(uuid())
  namaJenis String           @unique
  
  laporan   LaporanSampah[]  
}

model Wilayah {
  id          String           @id @default(uuid())
  namaWilayah String           @unique
  
  laporan     LaporanSampah[]  
}

model LaporanSampah {
  id            String        @id @default(uuid())
  berat         Float
  tanggalLapor  DateTime      @default(now())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  jenisSampahId String
  jenisSampah   JenisSampah   @relation(fields: [jenisSampahId], references: [id], onDelete: Restrict)

  wilayahId     String
  wilayah       Wilayah       @relation(fields: [wilayahId], references: [id], onDelete: Restrict)

  foto          FotoSampah?   

  @@unique([userId, jenisSampahId, tanggalLapor, wilayahId])
}

model FotoSampah {
  id        String        @id @default(uuid())
  imageUrl  String
  
  laporanId String        @unique 
  laporan   LaporanSampah @relation(fields: [laporanId], references: [id], onDelete: Cascade)
}